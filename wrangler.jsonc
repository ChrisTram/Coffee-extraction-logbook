{
  // Deploiement Cloudflare Workers avec fichiers statiques.
  // AUCUN build : les fichiers du depot sont servis tels quels.
  //
  // Le Worker (worker/index.js) est la porte d'entree : run_worker_first le
  // fait tourner AVANT le service des fichiers statiques, sinon la porte
  // serait contournable en demandant directement /index.html.
  //
  // Aucun secret ici, ce fichier est public. Les identifiants sont des
  // secrets Cloudflare (AUTH_USERNAME, AUTH_PASSWORD, AUTH_SECRET).
  "name": "coffee-extraction-logbook",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // SYNCHRONISATION ENTRE APPAREILS. Base creee le 12 aout 2026, region APAC.
  // Le nom du binding DOIT rester "DB" : c'est ce que le Worker lit (env.DB).
  // wrangler propose coffee_extraction_logbook, ne pas le suivre.
  // L'identifiant n'est pas un secret, c'est une reference de ressource, et il
  // ne donne acces a rien sans les cles du compte.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coffee-extraction-logbook",
      "database_id": "af7ee1b7-0e23-47bb-987a-310741425b57"
    }
  ],

  "observability": {
    "enabled": true
  }
}
