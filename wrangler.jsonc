{
  // Deploiement Cloudflare Workers avec fichiers statiques.
  // AUCUN build : les fichiers du depot sont servis tels quels.
  //
  // Le Worker (worker/index.js) est la porte d'entree : run_worker_first le
  // fait tourner AVANT le service des fichiers statiques, sinon la porte
  // serait contournable en demandant directement /index.html.
  //
  // Aucun secret ici, ce fichier est public. Les identifiants sont des
  // secrets Cloudflare (AUTH_USERNAME, AUTH_PASSWORD, AUTH_SECRET).
  "name": "coffee-extraction-logbook",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // SYNCHRONISATION ENTRE APPAREILS : decommenter le bloc ci dessous APRES
  // avoir cree la base, en collant l'identifiant renvoye par
  //   npx wrangler d1 create coffee-extraction-logbook
  // Il reste en commentaire pour que le depot soit toujours deployable en
  // l'etat : un database_id invalide ferait echouer wrangler deploy. Sans ce
  // binding, /api/sync repond 503 et le site marche comme avant, chaque
  // appareil avec ses propres donnees.
  //
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "coffee-extraction-logbook",
  //     "database_id": "coller ici l'id renvoye par wrangler d1 create"
  //   }
  // ],

  "observability": {
    "enabled": true
  }
}
